  m_Script: {fileID: 11500000, guid: 62a0ff9e6fffe374cbf49b3f3584a4ef, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LabDashboardController
  studentName: "\u041A\u041E\u041D\u0421\u0422\u0410\u041D\u0422\u0418\u041D\u041E\u041F\u041E\u041B\u042C\u0421\u041A\u0418\u0419-\u0421\u0415\u0412\u0415\u0420\u0421\u041A\u0418\u0419
    \u0410\u041B\u0415\u041A\u0421\u0410\u041D\u0414\u0420 \u0410\u041B\u0415\u041A\u0421\u0410\u041D\u0414\u0420\u041E\u0412\u0418\u0427"
  experimentTitle: "\u0418\u0417\u041C\u0415\u0420\u0415\u041D\u0418\u0415 \u0421\u041A\u041E\u0420\u041E\u0421\u0422\u0418
    \u0423\u0421\u041A\u041E\u0420\u0415\u041D\u0418\u042F \u0421\u0412\u041E\u0411\u041E\u0414\u041D\u041E\u0413\u041E
    \u041F\u0410\u0414\u0415\u041D\u0418\u042F"
  videoTitle: "DEMO: \u042D\u041A\u0421\u041F\u0415\u0420\u0418\u041C\u0415\u041D\u0422\u0410\u041B\u042C\u041D\u0410\u042F
    \u0423\u0421\u0422\u0410\u041D\u041E\u0412\u041A\u0410"
  labVideoClip: {fileID: 32900000, guid: 597e3ae2e01aed1488c14e4b05610134, type: 3}
  instructionSteps:
  - title: "1. \u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u043E\u0439
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435 \u043C\u0430\u044F\u0442\u043D\u0438\u043A"
    description: "\u0420\u0430\u0441\u043F\u043E\u043B\u0430\u0436\u0438\u0442\u0435
      \u043C\u0430\u044F\u0442\u043D\u0438\u043A \u0432 \u043E\u0434\u043D\u0443
      \u0438\u0437 \u043F\u043E\u0437\u0438\u0446\u0438\u0439 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u043A\u043D\u043E\u043F\u043A\u0438 Grip"
    image: {fileID: 2800000, guid: 4a11a9518b9ae234d9c16ce27dd706ed, type: 3}
  - title: "2. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440"
    description: "\u0423\u0431\u0435\u0434\u0438\u0442\u0438\u0441\u044C \u0447\u0442\u043E
      \u0443\u0433\u043E\u043B \u043E\u0442\u043A\u043B\u043E\u043D\u0430 \u043D\u0435
      \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442 15 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432"
    image: {fileID: 2800000, guid: c7359490a0e09ef4b84e68b49a8d6766, type: 3}
  - title: "3. \u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044E"
    description: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0442\u0430\u0439\u043C\u0435\u0440,
      \u0437\u0430\u0442\u0435\u043C \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435
      \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044E \u043A\u043D\u043E\u043F\u043A\u043E\u0439
      Start \u0433\u0440\u0443\u0437\u0438\u043A \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438"
    image: {fileID: 2800000, guid: 794ec5f3631e8dc4287bdd193552e7ea, type: 3}
