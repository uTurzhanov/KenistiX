/* --- ПЕРЕМЕННЫЕ ТЕМ --- */
.theme-dark {
    --bg-main: #13161C;
    --bg-sidebar: #1C2029;
    --bg-card: #222732;
    --bg-step: #1C2029;
    --bg-video: #0A0C10;
    --bg-modal-overlay: rgba(0, 0, 0, 0.7);
    --text-primary: #FFFFFF;
    --text-secondary: #8B94A5;
    --accent-blue: #1880FF;
    --accent-green: #1E8E3E;
    --border-color: rgba(255, 255, 255, 0.1);
}

.theme-light {
    --bg-main: #F9FAFB;
    --bg-sidebar: #F3F4F6;
    --bg-card: #FFFFFF;
    --bg-step: #F9FAFB;
    --bg-video: #0A0C10;
    --bg-modal-overlay: rgba(0, 0, 0, 0.4);
    --text-primary: #111827;
    --text-secondary: #6B7280;
    --accent-blue: #1880FF;
    --accent-green: #1E8E3E;
    --border-color: rgba(0, 0, 0, 0.1);
}

/* --- БАЗОВАЯ СТРУКТУРА --- */
#app-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family: sans-serif;
}

/* --- БОКОВАЯ ПАНЕЛЬ --- */
#sidebar {
    width: 260px;
    background-color: var(--bg-sidebar);
    border-right-width: 1px;
    border-color: var(--border-color);
    padding: 25px;
}

#sidebar-title {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 30px;
}

.nav-button {
    background-color: transparent;
    border-width: 0;
    color: var(--text-primary);
    font-size: 14px;
    font-weight: bold;
    padding: 15px;
    border-radius: 8px;
    text-align: left;
    margin-bottom: 10px;
    transition: background-color 0.2s;
}

.nav-button:hover {
    background-color: rgba(24, 128, 255, 0.2);
}

.nav-button.active {
    background-color: var(--accent-blue);
    color: #FFFFFF;
}

/* --- ОСНОВНАЯ ОБЛАСТЬ --- */
#main-content {
    flex-grow: 1;
    padding: 30px;
}

#header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

#header-title {
    font-size: 24px;
    font-weight: bold;
}

#header-controls {
    flex-direction: row;
    align-items: center;
}

#session-badge {
    flex-direction: row;
    background-color: rgba(30, 142, 62, 0.15);
    padding: 8px 16px;
    border-radius: 20px;
    align-items: center;
    margin-left: 20px;
    border-width: 1px;
    border-color: rgba(30, 142, 62, 0.3);
}

#session-dot {
    width: 8px;
    height: 8px;
    background-color: var(--accent-green);
    border-radius: 50%;
    margin-right: 8px;
}

/* --- КАРТОЧКИ --- */
#info-panels {
    flex-direction: row;
    margin-bottom: 20px;
}

.info-card {
    flex-grow: 1;
    background-color: var(--bg-card);
    border-radius: 12px;
    padding: 15px 20px;
    margin-right: 15px;
    border-width: 1px;
    border-color: var(--border-color);
}

.card-subtitle {
    font-size: 11px;
    color: var(--text-secondary);
    margin-bottom: 5px;
}

.card-title {
    font-size: 13px;
    font-weight: bold;
    white-space: normal;
}

/* --- КОНТЕЙНЕР КОНТЕНТА --- */
#content-container {
    background-color: var(--bg-card);
    border-radius: 16px;
    flex-grow: 1;
    padding: 25px;
    border-width: 1px;
    border-color: var(--border-color);
}

.content-title {
    font-size: 15px;
    font-weight: bold;
    color: var(--text-primary);
    margin-bottom: 15px;
    text-transform: uppercase;
}

/* --- ВИДЕО ПЛЕЕР --- */
#video-placeholder {
    flex-grow: 1;
    background-color: var(--bg-video);
    border-radius: 12px;
    margin-top: 10px;
    position: relative;
    min-height: 400px; /* Задаем жесткую минимальную высоту */
    -unity-background-scale-mode: scale-to-fit; /* Чтобы видео не искажалось, а вписывалось по пропорциям */
}

.video-demo-text {
    position: absolute;
    top: 20px;
    left: 20px;
    color: white;
    font-size: 12px;
    font-weight: bold;
}

#video-controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50px;
    background-color: rgba(0, 0, 0, 0.85);
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    flex-direction: row;
    align-items: center;
    padding: 0 15px;
}

.video-btn {
    background-color: transparent;
    border-width: 0;
    color: white;
    font-size: 14px;
    margin-right: 5px;
    padding: 8px 12px;
    border-radius: 6px;
}

.video-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.video-time-text {
    color: #CCCCCC;
    font-size: 13px;
    margin-left: 15px;
    font-weight: bold;
}

/* --- ШАГИ ИНСТРУКЦИИ --- */
.instruction-step {
    background-color: var(--bg-step);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
    border-width: 1px;
    border-color: var(--border-color);
}

.step-title {
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 10px;
}

.step-desc {
    font-size: 14px;
    white-space: normal;
    color: var(--text-secondary);
    margin-bottom: 15px;
    line-height: 20px;
}

.step-image-placeholder {
    height: 180px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 15px;
}

.step-image-btn {
    background-color: rgba(0,0,0,0.6);
    color: white;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 12px;
    border-width: 0;
}

.step-image-btn:hover {
    background-color: rgba(0,0,0,0.8);
}

/* --- МОДАЛЬНОЕ ОКНО --- */
#modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg-modal-overlay);
    align-items: center;
    justify-content: center;
}

#modal-window {
    background-color: var(--bg-card);
    width: 80%;
    height: 80%;
    border-radius: 16px;
    padding: 25px;
    border-width: 1px;
    border-color: var(--border-color);
}

#modal-image-full {
    flex-grow: 1;
    background-color: var(--bg-sidebar);
    border-radius: 12px;
}

/* --- НОВЫЕ КЛАССЫ ДЛЯ ИСПРАВЛЕНИЯ ОШИБКИ --- */
.modal-close-btn {
    background-color: transparent;
    border-width: 0;
    font-size: 18px;
    color: var(--text-primary);
}

.modal-close-btn:hover {
    color: #ff4444;
}

.modal-hint-text {
    font-size: 10px;
    color: var(--text-secondary);
    margin-top: 10px;
}
#section-video {
    flex-grow: 1;
}