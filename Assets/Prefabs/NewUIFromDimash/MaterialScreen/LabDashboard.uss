/* --- ПЕРЕМЕННЫЕ ТЕМ --- */
.theme-dark {
    --bg-main: #13161C;
    --bg-sidebar: #1C2029;
    --bg-card: #222732;
    --bg-step: #1C2029;
    --bg-video: #0A0C10;
    --bg-modal-overlay: rgba(0, 0, 0, 0.7);
    --text-primary: #FFFFFF;
    --text-secondary: #8B94A5;
    --accent-blue: #1880FF;
    --accent-green: #1E8E3E;
    --border-color: rgba(255, 255, 255, 0.1);
}

.theme-light {
    --bg-main: #F9FAFB;
    --bg-sidebar: #F3F4F6;
    --bg-card: #FFFFFF;
    --bg-step: #F9FAFB;
    --bg-video: #0A0C10;
    --bg-modal-overlay: rgba(0, 0, 0, 0.4);
    --text-primary: #111827;
    --text-secondary: #6B7280;
    --accent-blue: #1880FF;
    --accent-green: #1E8E3E;
    --border-color: rgba(0, 0, 0, 0.1);
}

/* --- БАЗОВАЯ СТРУКТУРА --- */
#app-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family: sans-serif;
}

/* --- БОКОВАЯ ПАНЕЛЬ --- */
#sidebar {
    width: 300px;
    background-color: var(--bg-sidebar);
    border-right-width: 1px;
    border-color: var(--border-color);
    padding: 28px;
}

#sidebar-title {
    font-size: 26px;
    font-weight: bold;
    margin-bottom: 32px;
}

.nav-button {
    background-color: transparent;
    border-width: 0;
    color: var(--text-primary);
    font-size: 20px;
    font-weight: bold;
    padding: 18px 20px;
    border-radius: 10px;
    text-align: left;
    margin-bottom: 12px;
    transition: background-color 0.2s;
}

.nav-button:hover {
    background-color: rgba(24, 128, 255, 0.2);
}

.nav-button.active {
    background-color: var(--accent-blue);
    color: #FFFFFF;
}

/* --- ОСНОВНАЯ ОБЛАСТЬ --- */
#main-content {
    flex-grow: 1;
    padding: 32px;
}

#header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
}

#header-title {
    font-size: 34px;
    font-weight: bold;
}

#header-controls {
    flex-direction: row;
    align-items: center;
}

#theme-toggle Label {
    font-size: 20px;
    color: var(--text-primary);
    margin-right: 8px;
}

#session-badge {
    flex-direction: row;
    background-color: rgba(30, 142, 62, 0.15);
    padding: 10px 20px;
    border-radius: 24px;
    align-items: center;
    margin-left: 24px;
    border-width: 1px;
    border-color: rgba(30, 142, 62, 0.3);
}

#session-badge Label {
    font-size: 16px;
    font-weight: bold;
}

#session-dot {
    width: 10px;
    height: 10px;
    background-color: var(--accent-green);
    border-radius: 50%;
    margin-right: 10px;
}

/* --- КАРТОЧКИ --- */
#info-panels {
    flex-direction: row;
    margin-bottom: 24px;
}

.info-card {
    flex-grow: 1;
    background-color: var(--bg-card);
    border-radius: 14px;
    padding: 18px 24px;
    margin-right: 16px;
    border-width: 1px;
    border-color: var(--border-color);
}

.card-subtitle {
    font-size: 16px;
    color: var(--text-secondary);
    margin-bottom: 6px;
}

.card-title {
    font-size: 19px;
    font-weight: bold;
    white-space: normal;
}

/* --- КОНТЕЙНЕР КОНТЕНТА --- */
#content-container {
    background-color: var(--bg-card);
    border-radius: 16px;
    flex-grow: 1;
    padding: 28px;
    border-width: 1px;
    border-color: var(--border-color);
}

#section-video {
    flex-grow: 1;
}

#section-instructions {
    flex-grow: 1;
}

.content-title {
    font-size: 22px;
    font-weight: bold;
    color: var(--text-primary);
    margin-bottom: 18px;
    text-transform: uppercase;
}

/* --- ВИДЕО ПЛЕЕР --- */
#video-placeholder {
    flex-grow: 1;
    background-color: var(--bg-video);
    border-radius: 12px;
    margin-top: 10px;
    position: relative;
    min-height: 400px;
    -unity-background-scale-mode: scale-to-fit;
}

.video-demo-text {
    position: absolute;
    top: 22px;
    left: 24px;
    color: white;
    font-size: 18px;
    font-weight: bold;
}

#video-controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 64px;
    background-color: rgba(0, 0, 0, 0.85);
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    flex-direction: row;
    align-items: center;
    padding: 0 20px;
}

.video-btn {
    background-color: transparent;
    border-width: 0;
    color: white;
    font-size: 20px;
    margin-right: 8px;
    padding: 10px 14px;
    border-radius: 8px;
}

.video-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.video-time-text {
    color: #CCCCCC;
    font-size: 19px;
    margin-left: 18px;
    font-weight: bold;
}

/* --- ШАГИ ИНСТРУКЦИИ --- */
.instruction-step {
    background-color: var(--bg-step);
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 22px;
    border-width: 1px;
    border-color: var(--border-color);
}

.step-title {
    font-size: 32px;
    font-weight: bold;
    margin-bottom: 12px;
    white-space: normal;
}

.step-desc {
    font-size: 28px;
    white-space: normal;
    color: var(--text-secondary);
    margin-bottom: 18px;
}

.step-image-placeholder {
    width: 640px;
    max-width: 100%;
    height: 360px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 12px;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 18px;
}

.step-image-btn {
    background-color: rgba(0, 0, 0, 0.7);
    color: white;
    padding: 12px 18px;
    border-radius: 8px;
    font-size: 20px;
    border-width: 0;
}

.step-image-btn:hover {
    background-color: rgba(0, 0, 0, 0.9);
}
/* --- МОДАЛЬНОЕ ОКНО --- */
#modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg-modal-overlay);
    align-items: center;
    justify-content: center;
}

#modal-window {
    background-color: var(--bg-card);
    width: 82%;
    height: 82%;
    border-radius: 16px;
    padding: 28px;
    border-width: 1px;
    border-color: var(--border-color);
}

.modal-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

#modal-image-full {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    background-color: var(--bg-sidebar);
    border-radius: 12px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}