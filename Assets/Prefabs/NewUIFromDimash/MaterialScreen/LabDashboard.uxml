<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="LabDashboard.uss" />
    
    <ui:VisualElement name="app-root" class="root-container">
        <!-- Боковая панель (Sidebar) -->
        <ui:VisualElement name="sidebar" class="sidebar">
            <ui:Label text="МАТЕРИАЛЫ" name="sidebar-title" class="sidebar-title" />
            <ui:VisualElement class="sidebar-divider" />
            <ui:VisualElement class="sidebar-menu">
                <ui:Button text="▶ ВИДЕО" name="tab-video" class="sidebar-btn active" />
                <ui:Button text="≡ ИНСТРУКЦИЯ" name="tab-instructions" class="sidebar-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Основная рабочая область (Main Content) -->
        <ui:VisualElement name="main-content" class="main-content">
            
            <!-- Верхняя панель (Top Bar) -->
            <ui:VisualElement name="header" class="top-bar">
                <ui:Label text="УЧЕБНЫЕ МАТЕРИАЛЫ" name="header-title" class="main-title" />
                <ui:VisualElement name="header-controls" class="top-controls">
                    <ui:Toggle name="theme-toggle" class="theme-switch">
                        <ui:VisualElement class="icon-sun" picking-mode="Ignore" />
                        <ui:VisualElement class="icon-moon" picking-mode="Ignore" />
                    </ui:Toggle>
                    <ui:VisualElement name="session-badge" class="session-btn">
                        <ui:VisualElement name="session-dot" class="status-dot" />
                        <ui:Label text="СЕССИЯ АКТИВНА" class="session-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Информационные карточки (Cards Row) -->
            <ui:VisualElement name="info-panels" class="cards-row">
                <ui:VisualElement class="info-card">
                    <ui:Label text="Студент" class="card-label" />
                    <ui:Label text="ИМЯ СТУДЕНТА" name="label-student-name" class="card-value-text student-name" />
                </ui:VisualElement>
                <ui:VisualElement class="info-card">
                    <ui:Label text="Эксперимент" class="card-label" />
                    <ui:Label text="НАЗВАНИЕ ЭКСПЕРИМЕНТА" name="label-experiment-name" class="card-value-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Контейнер контента (в стиле Table Card) -->
            <ui:VisualElement name="content-container" class="table-card">
                
                <!-- Секция 1: Видео -->
                <ui:VisualElement name="section-video" class="section-container">
                    <ui:VisualElement class="table-toolbar">
                        <ui:Label text="ОЗНАКОМИТЕЛЬНЫЙ ВИДЕОМАТЕРИАЛ" class="section-title" />
                    </ui:VisualElement>
                    <ui:VisualElement name="video-placeholder">
                        <ui:Label text="DEMO: ЭКСПЕРИМЕНТАЛЬНАЯ УСТАНОВКА" name="label-video-title" class="video-demo-text" />
                        <ui:VisualElement name="video-controls">
                            <ui:Button name="btn-rewind" text="⏪ 5с" class="video-btn" />
                            <ui:Button name="btn-play-pause" text="⏸" class="video-btn" />
                            <ui:Button name="btn-forward" text="⏩ 5с" class="video-btn" />
                            <ui:Label name="label-video-time" text="00:00 / 00:00" class="video-time-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Секция 2: Инструкции (скрыта по умолчанию) -->
                <ui:VisualElement name="section-instructions" class="section-container" style="display: none;">
                    <ui:VisualElement class="table-toolbar">
                        <ui:Label text="ПОШАГОВОЕ РУКОВОДСТВО К ВЫПОЛНЕНИЮ" class="section-title" />
                    </ui:VisualElement>
                    <ui:ScrollView name="instructions-scroll-view" class="gallery-scroll" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Модальное окно (скрыто по умолчанию) -->
        <ui:VisualElement name="modal-overlay" style="display: none;">
            <ui:VisualElement name="modal-window">
                <ui:VisualElement class="modal-header">
                    <ui:Label text="Название шага" name="modal-title" class="modal-title-text" />
                    <ui:Button text="✕" name="btn-close-modal" class="modal-close-btn" />
                </ui:VisualElement>
                
                <ui:VisualElement name="modal-image-full">
                    <ui:Label text="📷 НЕТ ФОТОГРАФИИ" name="modal-no-image-text" class="modal-no-image" />
                </ui:VisualElement>
                
                <ui:Label text="Нажмите ✕ или в любую область вне окна, чтобы вернуться к инструкции" class="modal-hint-text" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>