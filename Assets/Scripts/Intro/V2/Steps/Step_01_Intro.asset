  m_Name: Step_01_Intro
  m_EditorClassIdentifier: 
  stepTitle: "\u0417\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E \u0441
    \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439"
  stepDescription: "\u041F\u0440\u0438\u0432\u0435\u0442! \u0421\u0435\u0439\u0447\u0430\u0441
    \u043F\u0440\u043E\u0439\u0434\u0451\u043C \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
    \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0430\u0436 \u2014 \u044D\u0442\u043E
    \u0437\u0430\u0439\u043C\u0451\u0442 \u0432\u0441\u0435\u0433\u043E \u043F\u0430\u0440\u0443
    \u043C\u0438\u043D\u0443\u0442. \u0421\u043B\u0435\u0432\u0430 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
    \u0441\u043F\u0438\u0441\u043E\u043A \u0448\u0430\u0433\u043E\u0432, \u0438 \u043A\u0430\u043A
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435
    \u043D\u0443\u0436\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435,
    \u043F\u0430\u043D\u0435\u043B\u044C \u0441\u0430\u043C\u0430 \u043F\u043E\u0439\u043C\u0451\u0442
    \u044D\u0442\u043E \u0438 \u043F\u0435\u0440\u0435\u0439\u0434\u0451\u0442 \u0434\u0430\u043B\u044C\u0448\u0435.
    \u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0430\u0436\u0438\u043C\u0430\u0442\u044C
    \u043F\u043E\u043A\u0430 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u2014 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0441\u043B\u0435\u0434\u0443\u0439\u0442\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430\u043C."
