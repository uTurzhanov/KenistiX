<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="login-root-container" class="login-screen-root">
        
        <ui:VisualElement class="login-top-bar">
            <ui:VisualElement class="brand-badge">
                <ui:VisualElement class="status-dot" />
                <ui:Label text="IITU PLATONUS" class="brand-badge-text" />
            </ui:VisualElement>

            <ui:Toggle name="theme-toggle" class="theme-switch">
                <ui:VisualElement class="icon-sun" picking-mode="Ignore" />
                <ui:VisualElement class="icon-moon" picking-mode="Ignore" />
            </ui:Toggle>
        </ui:VisualElement>

        <ui:VisualElement class="login-center-wrapper">
            <ui:VisualElement class="login-card">
                <ui:Label text="Вход в систему" class="login-title" />
                <ui:Label text="Введите учетные данные Platonus МУИТ для начала работы" class="login-subtitle" />

                <ui:VisualElement class="login-divider" />

                <ui:VisualElement class="input-group">
                    <ui:Label text="Логин или корпоративная почта" class="input-label" />
                    <ui:TextField name="login-input" placeholder-text="37448@iitu.edu.kz" class="login-text-field" />
                </ui:VisualElement>

                <ui:VisualElement class="input-group">
                    <ui:Label text="Пароль" class="input-label" />
                    <ui:TextField name="password-input" mask-character="•" placeholder-text="••••••••" class="login-text-field" />
                </ui:VisualElement>

                <ui:VisualElement name="status-banner" class="status-banner">
                    <ui:Label name="status-label" text="" class="status-text" />
                </ui:VisualElement>

                <ui:Button name="login-button" text="Войти в Platonus" class="login-submit-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>