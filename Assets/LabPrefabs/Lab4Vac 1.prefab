  m_text: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0439\u0442\u0435
    \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430
    \u043E\u0442 0 \u0434\u043E 12 \u0412 \u0441 \u0448\u0430\u0433\u043E\u043C 2
    \u0412. \u0414\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
    \u0437\u0430\u043F\u0438\u0448\u0438\u0442\u0435 \u0441\u0438\u043B\u0443 \u0442\u043E\u043A\u0430
    \u0438 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u043D\u0430
    \u0441\u0432\u0435\u0442\u043E\u0434\u0438\u043E\u0434\u0435. \u0417\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0439\u0442\u0435
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F,
    \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0441\u0432\u0435\u0442\u043E\u0434\u0438\u043E\u0434
    \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0441\u0432\u0435\u0442\u0438\u0442\u044C\u0441\u044F."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
