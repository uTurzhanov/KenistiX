  m_text: "1.\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0446\u0435\u043F\u044C
    \u043F\u043E \u0441\u0445\u0435\u043C\u0435, \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0451\u043D\u043D\u043E\u0439
    \u043D\u0430 \u0440\u0438\u0441\u0443\u043D\u043A\u0435: \u0434\u0438\u043E\u0434,
    \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440, \u0432\u043E\u043B\u044C\u0442\u043C\u0435\u0442\u0440,
    \u0430\u043C\u043F\u0435\u0440\u043C\u0435\u0442\u0440 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F."
