  m_text: "6.\u041F\u043E\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0433\u0440\u0430\u0444\u0438\u043A\u0438
    \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u0441\u0438\u043B\u044B
    \u0442\u043E\u043A\u0430 \u043E\u0442 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F
    \u0438 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0435
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B. \u0421\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u0443\u0439\u0442\u0435
    \u0432\u044B\u0432\u043E\u0434 \u043E \u0432\u043B\u0438\u044F\u043D\u0438\u0438
    \u0446\u0432\u0435\u0442\u0430 \u0441\u0432\u0435\u0442\u043E\u0434\u0438\u043E\u0434\u0430
    \u043D\u0430 \u0435\u0433\u043E \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438.\n"
