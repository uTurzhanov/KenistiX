# Auto detect text files and perform LF normalization
* text=auto
# Текстовые файлы (Git)
*.cs text
*.meta text
*.unity text
*.prefab text
*.asset text

# LFS для бинарных файлов
*.png filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

